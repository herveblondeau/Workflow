API_KEY=your-secret-key

# Host port workflow-api is published on (VPS loopback). Default 8080.
# Change it when something else already holds 8080 on the box.
WORKFLOW_HOST_PORT=8080

# SSH port provision.sh uses to reach the VPS. Default 22.
# (Used only by the wizard, not by docker compose.)
VPS_SSH_PORT=22

OPENAI_API_KEY=
OPENAI_DEFAULT_MODEL=

ANTHROPIC_API_KEY=
ANTHROPIC_DEFAULT_MODEL=

GEMINI_API_KEY=
GEMINI_DEFAULT_MODEL=

OPENROUTER_API_KEY=
OPENROUTER_DEFAULT_MODEL=
