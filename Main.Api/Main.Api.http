@Main.Api_HostAddress = http://localhost:5261

GET {{Main.Api_HostAddress}}/api/analysis/status
Accept: application/json

###

#POST {{Main.Api_HostAddress}}/api/analysis/text
POST {{Main.Api_HostAddress}}/api/analysis/text
Content-Type: application/json
Accept: application/json

{
    "instructions": "Please summarize the main points of this text.",
    "language": "en",
    "text": "Artificial intelligence (AI) is transforming various industries by automating tasks, enhancing decision-making, and improving customer experiences. From healthcare to finance, AI technologies are being integrated to drive innovation and efficiency."
}

###

POST {{Main.Api_HostAddress}}/api/analysis/text
Content-Type: application/json
Accept: application/json

{
    "instructions": "Translate this text to French.",
    "language": "fr",
    "text": "Hello, how are you today?"
}

###

POST {{Main.Api_HostAddress}}/api/analysis/text
Content-Type: application/json
Accept: application/json

{
    "instructions": "",
    "language": null,
    "text": "This is a test without custom instructions. It should use the default instruction."
}

###

# Note: Multipart/form-data requests with binary files are best tested with Postman, curl, or similar tools
# Example curl command:
# curl -X POST "http://localhost:5261/api/analysis/image" \
#   -F "metadata={\"instructions\":\"Please extract and summarize the text from this image.\",\"language\":\"en\",\"source\":\"test\",\"cssWidth\":800,\"cssHeight\":600,\"pixelWidth\":1920,\"pixelHeight\":1080}" \
#   -F "image=@/path/to/image.png"

POST {{Main.Api_HostAddress}}/api/analysis/image
Content-Type: multipart/form-data; boundary=----WebKitFormBoundary7MA4YWxkTrZu0gW

------WebKitFormBoundary7MA4YWxkTrZu0gW
Content-Disposition: form-data; name="metadata"

{"instructions":"Please extract and summarize the text from this image.","language":"en","source":"test","cssWidth":800,"cssHeight":600,"pixelWidth":1920,"pixelHeight":1080}
------WebKitFormBoundary7MA4YWxkTrZu0gW
Content-Disposition: form-data; name="image"; filename="capture.png"
Content-Type: image/png

< /path/to/your/image.png
------WebKitFormBoundary7MA4YWxkTrZu0gW--

